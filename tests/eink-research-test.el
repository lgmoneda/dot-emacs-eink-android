;;; eink-research-test.el --- Bibliography integration -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defvar org-roam-db-location nil)
(defvar org-roam-directory nil)
(defvar org-id-locations-file nil)
(setq org-directory temporary-file-directory)
(defvar eink-state-directory temporary-file-directory)
(require 'eink-roam)
(require 'eink-research)
(require 'citar)
(require 'citar-file)
(defvar org-roam-directory nil)

(ert-deftest eink-research-citations-files-and-catalog-notes ()
  (let* ((root (make-temp-file "eink-research-" t))
         (eink-research-directory (expand-file-name "Research" root))
         (eink-research-bibliography-file (expand-file-name "library.bib" eink-research-directory))
         (org-roam-directory (expand-file-name "roam/roam-boox" root))
         (desktop-roam-directory (expand-file-name "roam" root))
         (desktop-roam-catalog-file (expand-file-name "catalog.json" root))
         (desktop-roam--stamp nil) (desktop-roam--nodes nil)
         (desktop-roam--candidates nil)
         (paper (expand-file-name "Literature/paper2026.pdf" eink-research-directory))
         (note (expand-file-name "paper2026.org" org-roam-directory)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory paper) t)
          (make-directory org-roam-directory t)
          (with-temp-file paper (insert "%PDF-1.4\n"))
          (with-temp-file eink-research-bibliography-file
            (insert "@article{paper2026, title={A paper}, author={Doe, Jane}, year={2026}, doi={10.123/example}}\n"))
          (with-temp-file note (insert "#+title: Local notes\n"))
          (with-temp-file desktop-roam-catalog-file
            (insert "{\"version\":1,\"nodes\":[{\"id\":\"desktop-paper-id\",\"title\":\"Existing note\",\"file\":\"unrelated-name.org\",\"level\":0,\"aliases\":[],\"citekeys\":[\"paper2026\"]}]}"))
          (eink-research-setup)
          (should (bound-and-true-p citar-embark-mode))
          (should (eq (lookup-key citar-embark-map (kbd "n"))
                      'citar-open-notes))
          (should (eq (alist-get 'citar-reference embark-keymap-alist)
                      'citar-embark-map))
          (should (equal citar-bibliography (list eink-research-bibliography-file)))
          (cl-letf (((symbol-function 'directory-files-recursively)
                     (lambda (&rest _) (ert-fail "Recursive scan")))
                    ((symbol-function 'org-roam-db-query)
                     (lambda (&rest _) (ert-fail "Desktop indexing/query"))))
            (should (member paper (gethash "paper2026" (citar-get-files "paper2026"))))
            (should (member "https://doi.org/10.123/example"
                            (gethash "paper2026" (citar-get-links "paper2026"))))
            (let ((notes (gethash "paper2026" (citar-get-notes "paper2026"))))
              (should (member note notes))
              (should (member "id:desktop-paper-id" notes)))
            (with-temp-buffer
              (org-mode)
              (cl-letf (((symbol-function 'citar-select-ref) (lambda (&rest _) "paper2026"))
                        ((symbol-function 'citar-select-refs) (lambda (&rest _) '("paper2026"))))
                (org-cite-insert nil))
              (should (equal (buffer-string) "[cite:@paper2026]"))))
          (should (member paper (eink-research--parse-file-field
                                "/Users/desktop/Library/CloudStorage/Dropbox/Research/Literature/paper2026.pdf")))
          ;; Android receives a file URI, so its own URI permission logic is used.
          (let ((system-type 'android) (opened nil))
            (cl-letf (((symbol-function 'browse-url-default-android-browser)
                       (lambda (url &rest _) (setq opened url))))
              (eink-research-open-paper paper)
              (should (string-prefix-p "file:///" opened)))))
      (delete-directory root t))))

(ert-deftest eink-research-new-note-has-persistent-citation-association ()
  (let* ((org-roam-directory (make-temp-file "boox-paper-note-" t))
         (file (expand-file-name "paper2026.org" org-roam-directory))
         (org-roam-db-location (expand-file-name "test.db" org-roam-directory))
         (org-id-locations-file (expand-file-name "ids" org-roam-directory)))
    (unwind-protect
        (save-window-excursion
          (require 'org-roam)
          (cl-letf (((symbol-function 'org-roam-db-sync)
                     (lambda (&rest _) (ert-fail "Unexpected collection scan"))))
            (eink-research--create-note "paper2026"
                                        '(("title" . "Reading a paper")
                                          ("author" . "Doe, Jane") ("year" . "2026")))
            (should (file-exists-p file))
            (should (file-equal-p buffer-file-name file))
            (goto-char (point-min))
            (should (org-entry-get (point) "ID"))
            (should (equal (org-entry-get (point) "ROAM_REFS") "@paper2026"))
            (should (equal (caar (org-roam-db-query
                                 [:select ref :from refs :where (= type "cite")]))
                           "paper2026"))
            (should (string-match-p (regexp-quote "#+ref: cite:paper2026") (buffer-string)))
            (should (string-match-p (regexp-quote "#+STARTUP: linkpreviews latexpreview") (buffer-string)))
            (should (string-match-p (regexp-quote "Reading a paper (2026), Doe, Jane") (buffer-string)))
            (should (string-match-p (regexp-quote "#+created: [") (buffer-string)))
            (goto-char (point-max))
            (insert "My reading notes\n")
            (save-buffer)
            (let ((content (buffer-string)))
              (eink-research--create-note "paper2026" nil)
              (should (equal content (buffer-string))))
            (should-error (eink-research--create-note "../bad" nil) :type 'user-error)))
      (when (bound-and-true-p org-roam-db-autosync-mode) (org-roam-db-autosync-mode -1))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (delete-directory org-roam-directory t))))
