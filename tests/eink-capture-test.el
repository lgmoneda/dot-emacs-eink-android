;;; eink-capture-test.el --- Capture destination integration -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defvar org-roam-db-location nil)
(defvar org-roam-directory nil)
(defvar org-id-locations-file nil)
(require 'org)
(defvar eink-state-directory temporary-file-directory)
(defvar eink-org-todo-file nil)
(require 'eink-roam)
(require 'eink-capture)

(ert-deftest eink-capture-personal-and-fleeting-destinations ()
  (let* ((root (make-temp-file "boox-captures-" t))
         (eink-fleeting-notes-file (expand-file-name "fleeting.org" root))
         (eink-org-todo-file (expand-file-name "todo.org" root)))
    (unwind-protect
        (save-window-excursion
          (with-temp-file eink-org-todo-file (insert "* Life\n** Misc\n"))
          (with-temp-buffer
            (org-mode)
            (org-capture nil "n")
            (insert "A fleeting thought")
            (org-capture-finalize)
            (org-capture-string "Personal task from selection" "d")
            (org-capture-finalize))
          (with-temp-buffer
            (insert-file-contents eink-fleeting-notes-file)
            (should (string-match-p "\\* A fleeting thought" (buffer-string)))
            (should (string-match-p "<[0-9]\\{4\\}-[0-9]\\{2\\}-[0-9]\\{2\\}" (buffer-string))))
          (with-current-buffer (find-file-noselect eink-org-todo-file)
            (goto-char (point-min))
            (search-forward "Personal task from selection")
            (should (= (org-outline-level) 3))
            (should (equal (org-get-outline-path) '("Life" "Misc")))
            (should (equal (org-get-todo-state) "TODO"))))
      (dolist (file (list eink-fleeting-notes-file eink-org-todo-file))
        (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest eink-roam-capture-routes-literature-through-bibliography ()
  (let ((called nil))
    (cl-letf (((symbol-function 'read-char-choice) (lambda (&rest _) ?r))
              ((symbol-function 'eink-research-create-note)
               (lambda () (interactive) (setq called 'bibliography)))
              ((symbol-function 'eink-roam-setup)
               (lambda (&rest _) (ert-fail "Literature chooser should load Citar first"))))
      (eink-roam-capture)
      (should (eq called 'bibliography)))))

(ert-deftest eink-roam-default-capture-has-desktop-header ()
  (let* ((root (make-temp-file "boox-default-capture-" t))
         (org-roam-directory root)
         (org-roam-db-location (expand-file-name "test.db" root))
         (org-id-locations-file (expand-file-name "ids" root)))
    (unwind-protect
        (save-window-excursion
          (require 'org-roam)
          (cl-letf (((symbol-function 'org-roam-db-sync)
                     (lambda (&rest _) (ert-fail "Unexpected full scan"))))
            (eink-roam-setup t)
            (org-roam-capture- :keys "d"
                               :node (org-roam-node-create :title "Tablet idea")
                               :props '(:finalize find-file))
            (insert "My note body")
            (org-capture-finalize)
            (should (string-prefix-p (file-truename root) (file-truename buffer-file-name)))
            (should (string-match-p (regexp-quote "#+title: Tablet idea") (buffer-string)))
            (should (string-match-p (regexp-quote "#+STARTUP: linkpreviews latexpreview") (buffer-string)))
            (should (string-match-p (regexp-quote "#+filetags: ") (buffer-string)))
            (should (string-match-p "My note body" (buffer-string)))))
      (when (bound-and-true-p org-roam-db-autosync-mode) (org-roam-db-autosync-mode -1))
      (dolist (buffer (buffer-list))
        (with-current-buffer buffer
          (when (and buffer-file-name
                     (file-in-directory-p buffer-file-name root))
            (set-buffer-modified-p nil) (kill-buffer buffer))))
      (delete-directory root t))))
